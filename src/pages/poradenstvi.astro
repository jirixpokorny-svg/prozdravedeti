---
import Layout from '../layouts/Layout.astro';
import OrderForm from '../components/OrderForm.astro';
import { getPhotoUrl } from '../lib/photos';
import type { PhotoSlotKey } from '../lib/photos';
import { CONSULTATIONS } from '../lib/catalog';

// Texty převzaty z původního webu (S čím vám pomohu / Jak probíhá mé poradenství)
const services = [
  {
    icon: '🤰',
    title: 'Výživa v těhotenství',
    slug: 'tehotenstvi',
    color: 'from-[#fef3dc] to-[#fef9ef]',
    accent: '#c07818',
    text: 'Čekáte miminko? Gratuluji! Pokud jste nezměnila stravovací návyky před početím, je dobré si je nastavit nyní. Jaké potraviny zařadit ve větší míře a které naopak vynechat? O kolik navýšit denní porce potravin? Jak vyřešit problémy s otoky končetin či těhotenskou cukrovkou?',
  },
  {
    icon: '🍼',
    title: 'Výživa kojících maminek',
    slug: 'kojeni',
    color: 'from-[#e8f5ec] to-[#f0faf4]',
    accent: '#3d7a4a',
    text: 'Miminko je už na světě, ale bříško je stále velké? Máte neustále hlad, ale ještě jste neshodila přebytečná kila po porodu, takže jíte málo? Tvoří se vám málo mléka? Nebojte se, pomohu vám to vyřešit.',
  },
  {
    icon: '🥣',
    title: 'Začínáme s příkrmy',
    slug: 'prikrmy',
    color: 'from-[#fce8e8] to-[#fff4f4]',
    accent: '#c04040',
    text: 'Přemýšlíte, kdy s nimi začít? Co a jak vařit? Jak na dítě, které příkrmy odmítá nebo naopak neví, kdy přestat? Trápí vás neprospívání dítěte? Pomohu vám s výživou již od první lžičky.',
  },
  {
    icon: '🧒',
    title: 'Výživa dětí od 1 roku',
    slug: 'deti',
    color: 'from-[#e8f0fb] to-[#f4f7fe]',
    accent: '#3a5fa0',
    text: 'První příkrmy jsou již zdárně za vámi, ale jak dál? Máte jasno v tom, jak by měla strava vašeho dítěte vypadat, ale narážíte na jiné postoje vašeho okolí? Pojďte si popovídat o tom, jak nerozhádat rodinu kvůli barevným bonbonům a bílým rohlíkům. Zdravá strava chce hlavně klid na duši a jasno v mysli.',
  },
  {
    icon: '⚖️',
    title: 'Úprava hmotnosti',
    slug: 'hmotnost',
    color: 'from-[#f0e8fb] to-[#f8f4fe]',
    accent: '#7a3d9a',
    text: 'Zdravé přibírání a redukce hmotnosti mají překvapivě mnoho společného. Chcete-li výživu nastavit zdravě, nepřibírat jen na rohlících a sladkostech, nebo naopak nesnažit se zhubnout nesmyslnými dietami s jojo efektem, ozvěte se mi, dáme tomu spolu smysl.',
  },
];

const steps = [
  { title: 'První krok', text: 'Už tím, že se mi ozvete, uděláte obrovský kus práce. Z vaší strany je potřeba jen rozhodnutí chtít změnu, vším ostatním vás provedu.' },
  { title: 'Vstupní dotazník', text: 'E-mailem vám pošlu vstupní dotazník. Je důležité, abyste nic nepřikrášlovali. V takovém případě nám bude trvat podstatně déle, než chyby objevíme.' },
  { title: 'Zpracování dat', text: 'Zpracování vašeho vyplněného dotazníku mi zabere nějaký čas, proto mi ho pošlete zpátky nejpozději 3 dny před naší schůzkou.' },
  { title: 'Setkání a zhodnocení', text: 'Cílem prvního setkání je upřesnění, jakým směrem se máte vydat a co je třeba začít měnit. Pěkně krok za krokem. Konzultace trvá přibližně 2 hodiny.' },
  { title: 'Změření', text: 'Zvážím a změřím vás, abychom měli vstupní hodnotu a abyste sama viděla, jak se nám na cestě daří. Chcete jen oživit a zpestřit stravu? Vážit a měřit se vůbec nemusíte :)' },
  { title: 'Změna', text: 'Po konzultaci obdržíte nejpozději do 3 dnů vše sepsané včetně doporučení, jak začít se změnami tak, aby byly pro vás jednoduché a dobře uchopitelné.' },
];

const servicePhotos = Object.fromEntries(
  services.map(s => [s.slug, getPhotoUrl(`sluzba-${s.slug}` as PhotoSlotKey)])
);
const selected = CONSULTATIONS.some(c => c.id === Astro.url.searchParams.get('konzultace'))
  ? Astro.url.searchParams.get('konzultace')!
  : 'komplexni';
const price = (n: number) => n.toLocaleString('cs-CZ') + ' Kč';
---

<Layout title="S čím vám pomůžu – Pro zdravé děti" description="Výživové poradenství pro těhotné, kojící maminky, příkrmy, výživa dětí od 1 roku, úprava hmotnosti. Jednorázová, komplexní a motivační konzultace. Lenka Pokorná, Písek.">

  <!-- Hero -->
  <section class="bg-gradient-to-br from-[#e8f5ec] via-[#faf8f3] to-[#fef3dc] py-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <span class="inline-flex items-center gap-2 bg-white text-[#3d7a4a] text-sm font-semibold px-4 py-1.5 rounded-full mb-4 shadow-sm border border-[#3d7a4a]/10">💬 Osobní i online konzultace</span>
      <h1 class="text-4xl md:text-5xl font-black text-[#2c2c2c] mb-4 leading-tight">S čím vám pomůžu</h1>
      <p class="text-lg text-gray-600 leading-relaxed max-w-xl mx-auto">
        V oblasti výživy vás provedu od těhotenství přes kojení, zdravé přibírání či snižování váhy až po výživu v nemoci.
      </p>
      <a href="#konzultace" class="btn-primary mt-8">Objednat konzultaci</a>
    </div>
  </section>

  <!-- Oblasti -->
  <section class="max-w-5xl mx-auto px-4 py-14 space-y-16">
    {services.map((s, i) => (
      <div class={`grid md:grid-cols-2 gap-10 items-center ${i % 2 === 1 ? 'md:[&>*:first-child]:order-2' : ''}`}>
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="text-4xl">{s.icon}</span>
            <h2 class="text-2xl font-black text-[#2c2c2c]">{s.title}</h2>
          </div>
          <p class="text-gray-600 leading-relaxed">{s.text}</p>
          <div class="mt-6">
            <a href="#konzultace" class="inline-flex items-center gap-2 text-sm font-bold hover:underline" style={`color:${s.accent}`}>
              Chci konzultaci →
            </a>
          </div>
        </div>
        {servicePhotos[s.slug] ? (
          <div class="aspect-[4/3] rounded-3xl overflow-hidden shadow-lg">
            <img src={servicePhotos[s.slug]!} alt={s.title} class="w-full h-full object-cover" />
          </div>
        ) : (
          <div class={`aspect-[4/3] rounded-3xl bg-gradient-to-br ${s.color} border-2 border-dashed flex flex-col items-center justify-center text-center p-8`} style={`border-color:${s.accent}30`}>
            <div class="text-5xl mb-3">{s.icon}</div>
            <p class="font-semibold text-sm" style={`color:${s.accent}`}>Fotografie: {s.title}</p>
          </div>
        )}
      </div>
    ))}
  </section>

  <!-- Jak probíhá poradenství -->
  <section id="jak-probiha" class="bg-white py-14">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl font-black text-[#2c2c2c] mb-3 text-center">Jak probíhá mé poradenství?</h2>
      <p class="text-center text-gray-600 max-w-3xl mx-auto mb-10 leading-relaxed">
        Začínáme dřív, než se vidíme. Nabízím tři typy konzultací: jednorázovou (krátká, stručná, na konkrétní problém), komplexní (podrobná do historie vašich stravovacích návyků, aktivit a stylu života, předurčující další spolupráci) a na ni navazující motivační (ke zhodnocování vaší cesty k cíli a k motivaci pokračovat).
      </p>
      <h3 class="text-xl font-black text-[#2c2c2c] mb-6 text-center">Co vás čeká před komplexní konzultací a na ní?</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {steps.map((st, i) => (
          <div class="rounded-2xl bg-[#faf8f3] p-6">
            <div class="w-10 h-10 bg-[#3d7a4a] text-white rounded-full flex items-center justify-center font-black text-lg mb-3">{i + 1}</div>
            <h4 class="font-bold text-[#2c2c2c] mb-2">{st.title}</h4>
            <p class="text-gray-600 text-sm leading-relaxed">{st.text}</p>
          </div>
        ))}
      </div>
      <div class="grid md:grid-cols-2 gap-6 mt-10">
        <div class="rounded-2xl border-l-4 border-[#f5a623] bg-[#fef9ef] p-6">
          <h3 class="font-black text-lg mb-2">Co očekávat nemůžete?</h3>
          <p class="text-sm text-gray-700 leading-relaxed">Způsob mé práce je odlišný od víkendových výživových poradců a doporučení z časopisů. Především ode mě nechtějte jídelníčky na míru. Ty nenastavuji proto, že z mé zkušenosti nemají pro nikoho z dlouhodobého pohledu žádný efekt. Mnohem prospěšnější pro vás je naučit se, jak se jídelníček dělá. Díky tomu začnete svému tělu rozumět vy sami a jen tak je změna udržitelná.</p>
        </div>
        <div class="rounded-2xl border-l-4 border-[#3d7a4a] bg-[#f0faf4] p-6">
          <h3 class="font-black text-lg mb-2">Potkáme se osobně, nebo virtuálně?</h3>
          <p class="text-sm text-gray-700 leading-relaxed">Konzultace nemusíte absolvovat osobně, můžeme se potkat i online. Je jen na vás, jaké máte možnosti a jakou cestu si zvolíte.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Konzultace + objednávka -->
  <section id="konzultace" class="py-14">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl font-black text-[#2c2c2c] mb-10 text-center">Objednejte se na konzultaci</h2>
      <div class="grid md:grid-cols-3 gap-5 mb-12">
        {CONSULTATIONS.map(c => (
          <div class={`card p-6 flex flex-col ${c.id === 'komplexni' ? 'ring-2 ring-[#3d7a4a]' : ''}`}>
            <h3 class="font-black text-xl text-[#2c2c2c] mb-1">{c.title}</h3>
            <p class="text-2xl font-black text-[#3d7a4a] mb-1">{price(c.price)}</p>
            <p class="text-xs text-gray-500 mb-4">{c.duration}</p>
            <p class="text-sm text-gray-600 leading-relaxed mb-4 flex-1">{c.summary}</p>
            <p class="text-xs text-gray-700 bg-[#e8f5ec] rounded-xl p-3"><strong>Cena zahrnuje:</strong> {c.includes}</p>
          </div>
        ))}
      </div>
      <div class="max-w-xl mx-auto bg-white rounded-3xl shadow-sm border border-gray-100 p-6 md:p-8">
        <h3 class="text-xl font-black mb-1">Objednávka konzultace</h3>
        <p class="text-sm text-gray-500 mb-5">Vyplňte formulář a já se vám ozvu. Domluvíme se na termínu, platbě a u komplexní konzultace vám pošlu vstupní dotazník.</p>
        <OrderForm
          kind="consultation"
          items={CONSULTATIONS.map(c => ({ value: c.id, label: `${c.title} (${price(c.price)})` }))}
          itemsLabel="Typ konzultace"
          selectedItem={selected}
          meeting
          noteLabel="S čím potřebujete poradit?"
          submitLabel="Odeslat objednávku"
          successText="Děkuji za vaši důvěru. Co nejdříve se vám ozvu."
        />
      </div>
      <p class="text-center text-sm text-gray-500 mt-6">Psaní pro vás není? Zavolejte mi: <a href="tel:+420725757041" class="font-bold text-[#3d7a4a]">+420 725 757 041</a></p>
    </div>
  </section>

</Layout>

---
import Layout from '../../layouts/Layout.astro';
import FlyerZoom from '../../components/FlyerZoom.astro';
import OrderForm from '../../components/OrderForm.astro';
import { getDb } from '../../lib/db';
import { formatDate, formatPrice } from '../../lib/slugify';
import type { Seminar } from '../../lib/db';
import { parsePriceOptions } from '../../lib/db';

const { slug } = Astro.params;
const db = getDb();
const seminar = db.prepare("SELECT * FROM seminars WHERE slug = ? AND active = 1").get(slug) as Seminar | undefined;
if (!seminar) return Astro.redirect('/seminare');
const options = parsePriceOptions(seminar.price_options);
const isPast = new Date(seminar.date_from) < new Date(new Date().toDateString());
---

<Layout title={`${seminar.title} – Pro zdravé děti`} description={seminar.description.slice(0, 160)}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <a href="/seminare" class="inline-flex items-center gap-2 text-[#3d7a4a] font-semibold text-sm mb-6 hover:underline">← Zpět na semináře</a>

    <div class="grid md:grid-cols-2 gap-10 items-start">
      <div>
        {seminar.poster_url
          ? <FlyerZoom src={seminar.poster_url} alt={seminar.title} />
          : <div class="w-full aspect-[3/4] bg-gradient-to-br from-[#fef3dc] to-[#f0ebe0] rounded-3xl flex items-center justify-center text-8xl shadow-inner">🎓</div>
        }
      </div>

      <div class="sticky top-24">
        <span class="bg-[#fef3dc] text-[#c07818] text-xs font-bold px-3 py-1 rounded-full">Seminář / kurz</span>
        <h1 class="text-3xl font-black text-[#2c2c2c] mt-3 mb-4">{seminar.title}</h1>

        <div class="bg-[#fef3dc] rounded-2xl p-5 mb-6 space-y-2">
          <div class="flex items-center gap-3 text-sm"><span class="text-lg">📅</span><span class="font-semibold">{formatDate(seminar.date_from)}</span></div>
          {seminar.time_info && <div class="flex items-center gap-3 text-sm"><span class="text-lg">🕐</span><span>{seminar.time_info}</span></div>}
          <div class="flex items-center gap-3 text-sm"><span class="text-lg">📍</span><span>{seminar.location}</span></div>
          <div class="flex items-center gap-3">
            <span class="text-lg">💰</span>
            {options.length > 0
              ? <span class="text-sm"><span class="text-xl font-black text-[#c07818]">od {formatPrice(Math.min(...options.map(o => o.price)))}</span><br/><span class="text-gray-600">{options.map(o => `${o.label}: ${formatPrice(o.price)}`).join(' · ')}</span></span>
              : seminar.price !== null
                ? <span class="text-xl font-black text-[#c07818]">{formatPrice(seminar.price)}</span>
                : <span class="text-sm font-semibold text-gray-600">Cena na vyžádání</span>
            }
          </div>
        </div>

        <div class="prose prose-sm text-gray-700 mb-6" set:html={seminar.description.replace(/\n/g, '<br/>')} />

        {isPast ? (
          <div class="bg-gray-100 rounded-2xl p-5 text-center">
            <p class="font-bold text-gray-600 mb-2">Tento kurz už proběhl</p>
            <p class="text-sm text-gray-500">Aktuální termíny najdete v <a href="/seminare" class="text-[#3d7a4a] font-semibold">přehledu kurzů</a>. Chcete dát vědět o dalším termínu? Napište na <a href="mailto:info@prozdravedeti.cz" class="text-[#3d7a4a] font-semibold">info@prozdravedeti.cz</a>.</p>
          </div>
        ) : (
          <div>
            <h2 class="text-xl font-bold text-[#2c2c2c] mb-4">Přihláška</h2>
            <OrderForm kind="seminar" itemId={seminar.id} options={options} noteLabel="Dotaz nebo poznámka" submitLabel="Odeslat přihlášku" successText="Přihláška odeslána! Potvrzení s platebními údaji jsem poslala na váš e-mail." />
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>


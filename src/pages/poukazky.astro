---
import Layout from '../layouts/Layout.astro';
import OrderForm from '../components/OrderForm.astro';
import { VOUCHERS } from '../lib/catalog';

const price = (n: number) => n.toLocaleString('cs-CZ') + ' Kč';
const selected = VOUCHERS.find(v => v.id === Astro.url.searchParams.get('poukaz'));
// Varianty pro formulář: u poukazu s více hodnotami se varianta vybírá zvlášť
const items = VOUCHERS.map(v => ({ value: v.id, label: v.options ? `${v.title} (od ${price(v.price)})` : `${v.title} (${price(v.price)})` }));
const kurzOptions = VOUCHERS.find(v => v.options)!.options!;
---

<Layout title="Dárkové poukázky – Pro zdravé děti" description="Dárkové poukazy na kurzy vaření, výživové konzultace a párové vaření s vinnou degustací.">
  <section class="bg-gradient-to-br from-[#fef3dc] via-[#faf8f3] to-[#e8f5ec] py-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <span class="inline-flex items-center gap-2 bg-white text-[#c07818] text-sm font-semibold px-4 py-1.5 rounded-full mb-4 shadow-sm">🎁 Dárek, který nezapadne do šuplíku</span>
      <h1 class="text-4xl md:text-5xl font-black text-[#2c2c2c] mb-4">Dárkové poukázky</h1>
      <p class="text-lg text-gray-600 max-w-xl mx-auto">Darujte zážitek, péči o zdraví nebo radost z vaření. Po zaplacení vám pošlu poukaz e-mailem, připravený k vytištění nebo předání.</p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-14">
    <div class="grid md:grid-cols-2 gap-6 mb-14">
      {VOUCHERS.map(v => (
        <div class="card p-6 flex flex-col sm:flex-row gap-5">
          {v.image && <img src={v.image} alt={v.title} class="w-full sm:w-52 h-auto self-start rounded-2xl flex-shrink-0 shadow-sm" loading="lazy" />}
          <div class="flex-1 flex flex-col">
            <h2 class="font-black text-lg text-[#2c2c2c] mb-1">{v.title}</h2>
            <p class="text-xl font-black text-[#c07818] mb-3">{v.options ? `${price(Math.min(...v.options.map(o => o.price)))} – ${price(Math.max(...v.options.map(o => o.price)))}` : price(v.price)}</p>
            <p class="text-sm text-gray-600 leading-relaxed mb-4 flex-1">{v.summary}</p>
            <a href={`?poukaz=${v.id}#objednat`} class="btn-warm !py-2 text-sm self-start">Objednat poukaz</a>
          </div>
        </div>
      ))}
    </div>

    <div id="objednat" class="max-w-xl mx-auto bg-white rounded-3xl shadow-sm border border-gray-100 p-6 md:p-8 scroll-mt-24">
      <h2 class="text-xl font-black mb-1">Objednávka poukazu</h2>
      <p class="text-sm text-gray-500 mb-5">Do poznámky napište, komu je poukaz určen, případně věnování. Platební údaje přijdou e-mailem.</p>
      <OrderForm
        kind="voucher"
        items={items}
        itemsLabel="Poukaz"
        selectedItem={selected?.id ?? VOUCHERS[0].id}
        options={kurzOptions}
        noteLabel="Komu je poukaz určen, věnování"
        submitLabel="Objednat poukaz"
        successText="Děkuji! Platební údaje jsem poslala na váš e-mail. Po zaplacení vám pošlu poukaz."
      />
      <p class="text-xs text-gray-400 mt-3">Volba hodnoty platí jen pro poukaz „Kurz dle vlastního výběru“.</p>
    </div>
  </section>
</Layout>

<script>
  // Výběr hodnoty dává smysl jen u poukazu na kurz dle výběru
  const form = document.querySelector<HTMLFormElement>('#objednat .order-form');
  const item = form?.querySelector<HTMLSelectElement>('select[name=item_id]');
  const variant = form?.querySelector<HTMLSelectElement>('select[name=variant]');
  const sync = () => {
    if (!item || !variant) return;
    const on = item.value === 'kurz-dle-vyberu';
    variant.disabled = !on;
    variant.closest('div')!.classList.toggle('hidden', !on);
  };
  item?.addEventListener('change', sync);
  sync();
</script>
